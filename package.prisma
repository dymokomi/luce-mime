#prisma 4.0
def package "luce-mime" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "Internet messages in luce-base: RFC 5322 headers, addresses and dates, RFC 2047 encoded words, the MIME part tree, base64 and quoted-printable, charsets decoded to UTF-8, a readable text view of a body, and outgoing messages built for SMTP."
    str readme = "README.md"

    def export "mime" {
        str module = "luce_mime.mime"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.5"
        str path = "../luce-std"
    }
}
